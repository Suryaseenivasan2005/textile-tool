# Backend Environment Variables

# Required for production deployment on Render
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Optional - defaults to 3000 if not set (Render will set this automatically)
PORT=3000

# Optional - defaults to 'development'
NODE_ENV=production

# Optional - Secret key for production database seeding (set this to enable seeding in production)
SEED_KEY=your-secret-seed-key-for-production-only

# Optional - Frontend URL for CORS (defaults to all Vercel domains in production)
FRONTEND_URL=https://your-app.vercel.app
